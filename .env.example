# =============================================================================
# Iturrieta API — environment template (safe to commit; no real secrets)
# Copy to `.env` and fill in values. Never commit `.env`.
# =============================================================================

# Runtime
# NODE_ENV: development | production | test
NODE_ENV=development
# HTTP port for Express + Socket.IO (default 5000)
PORT=5000
# Allowed browser origins for CORS (comma-separated, no trailing paths).
# Local: http://localhost:5173
# Production (Render): include Vercel + localhost for local API testing, e.g.
# CLIENT_URL=https://iturrieta-sagardotegia.vercel.app,http://localhost:5173
# Vercel preview URLs matching iturrieta-sagardotegia*.vercel.app are also allowed automatically.
# Set NODE_ENV=production on Render (not development) so errors do not leak stack traces.
CLIENT_URL=http://localhost:5173
# Public API root (used for cross-site cookie SameSite=None detection in production)
API_BASE_URL=http://localhost:5000

# MongoDB connection string (required)
# Local example: mongodb://127.0.0.1:27017/iturrieta
MONGODB_URI=replace-with-your-mongodb-connection-string

# JWT signing secrets (required, min 32 characters each — generate two unique values)
# Example: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-a-unique-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-unique-refresh-secret-min-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Gmail SMTP (required in production when EMAIL_MOCK=false)
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM_NAME=Iturrieta Sagardotegia
MAIL_FROM_ADDRESS=your-gmail-address@gmail.com

# OTP behaviour
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# true = booking/OTP emails log as [email:mock] in the API terminal (no inbox); false + SMTP_* sends real mail
EMAIL_MOCK=true

# Business hours timezone for booking rules
VENUE_TIMEZONE=Europe/Madrid

# Optional one-time bootstrap for staff/admin (both email + password required per role)
# Leave blank unless you intentionally provision privileged accounts on first seed
STAFF_BOOTSTRAP_EMAIL=
STAFF_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
